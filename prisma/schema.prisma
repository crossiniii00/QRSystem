datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
}

enum AcademicLevel {
  K12_SHS
  COLLEGE
  TVET
  GRADUATE
}

enum ApplicantType {
  FRESHMAN
  TRANSFEREE
  RETURNEE
  CROSS_ENROLLEE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  ENROLLED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AuditActorType {
  SYSTEM
  STUDENT
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  fullName     String   @map("full_name")
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reviewedApplications Application[]
  verifiedDocuments    Document[]

  @@map("users")
}

model Program {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  description   String
  department    String
  academicLevel AcademicLevel @map("academic_level")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  applications Application[]
  campaigns    QRCampaign[]

  @@map("programs")
}

model Requirement {
  id                 String   @id @default(uuid())
  code               String   @unique
  title              String
  description        String
  allowedMimeTypes   String[] @map("allowed_mime_types")
  maxFileSizeBytes   BigInt   @map("max_file_size_bytes")
  isMandatory        Boolean  @default(true) @map("is_mandatory")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("requirements")
}

model QRCampaign {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  description      String?
  destinationPath  String    @map("destination_path")
  defaultProgramId String?   @map("default_program_id")
  scanCount        Int       @default(0) @map("scan_count")
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  defaultProgram Program?      @relation(fields: [defaultProgramId], references: [id])
  applications   Application[]

  @@map("qr_campaigns")
}

model Applicant {
  id                           String   @id @default(uuid())
  email                        String
  mobileNumber                 String   @map("mobile_number")
  firstName                    String   @map("first_name")
  middleName                   String?  @map("middle_name")
  lastName                     String   @map("last_name")
  dateOfBirth                  String   @map("date_of_birth")
  sex                          String
  civilStatus                  String?  @map("civil_status")
  addressStreet                String   @map("address_street")
  addressCity                  String   @map("address_city")
  addressProvince              String   @map("address_province")
  addressPostalCode            String?  @map("address_postal_code")
  emergencyContactName         String   @map("emergency_contact_name")
  emergencyContactRelationship String   @map("emergency_contact_relationship")
  emergencyContactPhone        String   @map("emergency_contact_phone")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@index([email])
  @@map("applicants")
}

model Application {
  id                    String            @id @default(uuid())
  referenceNumber       String            @unique @map("reference_number")
  accessTokenHash       String            @map("access_token_hash")
  applicantId           String            @map("applicant_id")
  programId             String            @map("program_id")
  qrCampaignId          String?           @map("qr_campaign_id")
  applicantType         ApplicantType     @map("applicant_type")
  academicYear          String            @map("academic_year")
  semesterTerm          String            @map("semester_term")
  previousSchool        String?           @map("previous_school")
  previousSchoolAddress String?           @map("previous_school_address")
  previousGpa           String?           @map("previous_gpa")
  status                ApplicationStatus @default(DRAFT)
  revisionNotes         String?           @map("revision_notes")
  rejectionReason       String?           @map("rejection_reason")
  submittedAt           DateTime?         @map("submitted_at")
  reviewedAt            DateTime?         @map("reviewed_at")
  reviewedByUserId      String?           @map("reviewed_by_user_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  applicant      Applicant   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  program        Program     @relation(fields: [programId], references: [id])
  qrCampaign     QRCampaign? @relation(fields: [qrCampaignId], references: [id])
  reviewedByUser User?       @relation(fields: [reviewedByUserId], references: [id])

  documents Document[]

  @@index([status])
  @@index([referenceNumber])
  @@index([accessTokenHash])
  @@map("applications")
}

model Document {
  id                 String                     @id @default(uuid())
  applicationId      String                     @map("application_id")
  requirementId      String                     @map("requirement_id")
  storageKey         String                     @unique @map("storage_key")
  originalFilename   String                     @map("original_filename")
  mimeType           String                     @map("mime_type")
  fileSizeBytes      BigInt                     @map("file_size_bytes")
  fileHashSha256     String                     @map("file_hash_sha256")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?                    @map("rejection_reason")
  uploadedAt         DateTime                   @default(now()) @map("uploaded_at")
  verifiedAt         DateTime?                  @map("verified_at")
  verifiedByUserId   String?                    @map("verified_by_user_id")

  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement    Requirement @relation(fields: [requirementId], references: [id])
  verifiedByUser User?       @relation(fields: [verifiedByUserId], references: [id])

  @@index([applicationId])
  @@index([requirementId])
  @@map("documents")
}

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType @map("actor_type")
  actorId    String         @map("actor_id")
  actorEmail String?        @map("actor_email")
  action     String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  metadata   Json?
  ipAddress  String?        @map("ip_address")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
